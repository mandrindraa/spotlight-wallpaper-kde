[Unit]
Description=Run Spotlight Wallpaper Changer periodically
Requires=spotlight-wallpaper.service

[Timer]
# Fire 90 seconds after login (gives Plasma time to finish starting)
OnBootSec=90s
# Then every hour while logged in
OnUnitActiveSec=1h
# If the timer was missed (e.g. PC was off), run it as soon as possible
Persistent=true

[Install]
WantedBy=timers.target
